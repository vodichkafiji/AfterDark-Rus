default Autumngymintro = False
default Autumncityintro = False



label brooklyn_intro:

    scene intro 0 with fade
    stop ambient fadeout 1.0
    "В классе шумно, как обычно: гул разговоров, шелест бумаг и едва слышный гул люминесцентных ламп."

    scene brooklynintro (1) with fade
    "Ты замечаешь Бруклин, которая беспечно перебирает струны гитары, явно погружённая в свои мысли."

    "Любопытство берёт верх, и ты решаешь подойти к ней."

    mc "Привет."

    scene brooklynintro (2) with dissolve

    "Она поднимает взгляд, её глаза встречаются с твоими. Никакого испуга — лишь вспышка удивления."

    "Она замирает на полуслове струн, и в уголке её губ появляется легкая, неуверенная улыбка."

    b "Привет."



    "Её голос тихий, но в нём есть то тепло, из-за которого кажется, будто ты застал её в редкий момент полного спокойствия."

    mc "Я [mcname]. Кажется, мы учимся в одном классе."

    mc "В смысле... ну да... учитывая, что мы прямо сейчас оба сидим в этом классе..."

    mc "(Чёрт возьми, до чего же хреново у меня получается общаться.)"

    scene brooklynintro (5) with dissolve

    "Она медленно кивает, словно переваривая твои слова."

    b "Да… я видела тебя. Я Бруклин."

    "Наступает неловкая пауза, но она совсем не тяготит."

    "Ты замечаешь, как её рука слегка постукивает по деке гитары, выбивая тихий ритм в такт общей атмосфере."

    mc "Так ты играешь?"

    scene brooklynintro (3) with dissolve

    "Её взгляд скользит к гитаре, и она снова кивает, в её лице проскальзывает капля стеснения."

    b "Да… так, знаешь, чисто для себя."

    mc "И как, хорошо получается?"

    scene brooklynintro (4) with dissolve

    "Она снова смотрит на тебя, и в её глазах вспыхивает лёгкий вызов, будто она подстрекает тебя оценить её."

    b "Да не особо. Мне просто… нравится."

    "Ты опираешься на парту рядом с ней, пытаясь разрядить обстановку."

    scene brooklynintro (6) with dissolve

    mc "Сыграешь что-нибудь?"

    "Пальцы Бруклин замирают на краешках струн, и на мгновение кажется, что она сейчас откажется."

    b "Даже не знаю… Я же говорю, я не мастер."
    scene brooklynintro (7) with dissolve

    mc "Обещаю не освистывать. Может, даже поаплодирую."

    scene brooklynintro (8) with dissolve

    "Это вызывает у неё лёгкий смешок. Она оглядывает класс, замечая, что большинство слишком увлечены своими разговорами, чтобы обращать внимание."

    b "Ладно. Но если я сфальшивлю… вся вина на тебе."

    mc "По рукам."

    scene brooklynintro (9) with fade

    "Её пальцы пробегают по струнам, проверяя звук, перед тем как начать."

    "Мелодия сначала звучит тихо — неуверенная вязь нот, которая постепенно обретает силу."

    "В этом есть какая-то сырая, необработанная искренность, которая приковывает твоё внимание."

    "Когда она заканчивает, наступает секундная тишина. Она поднимает на тебя взгляд, в котором смешались уязвимость и упрямство."

    mc "Это было… реально круто."

    scene brooklynintro (11) with dissolve

    "Она опускает голову, на её губах играет улыбка."

    b "Ты просто так говоришь."

    mc "Вовсе нет. Серьёзно."

    "Её глаза снова встречаются с твоими, и на секунду ты замечаешь искру чего-то… возможно, взаимопонимания."
    scene brooklynintro (10) with dissolve


    b "Спасибо... Я ценю это."

    scene brooklynintro (11) with dissolve

    b "Я, эм... обычно зависаю после уроков… в коридоре. Если захочешь, ну… болтать о музыке или типа того."

    mc "Я буду иметь в виду."

    b "Увидимся, [mcname]."

    mc "Ага. До встречи."
    $ unlock_event(Brooklyn, "A Shy Strummer", "brooklyn_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ intro_brooklyn += 1
        $ Brooklyn.affection += 1
        $ Brooklyn.quest = "Бруклин должна быть в коридоре после уроков, иди поговори с ней."

        "{i}Привязанность Бруклин увеличена.{/i}"

        jump weekday_afternoon


label brooklyn_hallway_intro:

    scene black with fade
    play music "audio/Music/brooklyn.mp3"
    "Звук тихих гитарных переборов ведёт тебя в более спокойное крыло коридора."
    "Ты идёшь на него, лавируя между группами учеников, пока не находишь Бруклин. Она опирается на стену, не отрывая глаз от струн под своими пальцами."

    "В её музыке есть тихая глубина: каждая нота звучит чётко и искренне."
    "Ты на секунду мешкаешь, не желая мешать, а затем прокашливаешься."
    scene brooklynhallintro (6) with dissolve
    mc "Привет. Не ожидал тебя тут встретить."

    scene brooklynhallintro (7) with dissolve

    "Она поднимает взгляд, мелодия сбивается. На её губах появляется тихая улыбка — тёплая, но сдержанная."

    b "Привет. Я прихожу сюда, когда… ну, знаешь, везде слишком шумно."

    "Ты киваешь, делая шаг ближе."

    mc "Логично. Хорошее местечко."

    scene brooklynhallintro (9) with dissolve

    "Она слегка переминается с ноги на ногу, её пальцы лениво перебирают пару нот."

    b "Ага. Приятно просто… играть, когда никого нет рядом."

    "Ты на мгновение задумываешься о том, как именно она говорит о музыке — без пафоса и бахвальства, а с той тихой страстью, которая, кажется, заполняет всё пространство между вами."
    scene brooklynhallintro (10) with dissolve
    mc "И над чем ты работаешь?"

    "Она бросает взгляд на гитару, будто только что вспомнила про неё."

    scene brooklynhallintro (11) with dissolve

    b "Да так… кое-что новое. Ещё не закончила."

    mc "Не против, если я послушаю?"

    "Она колеблется, закусывая губу."

    b "Это… такое себе."

    mc "А вот это я сам решу."

    "Она тихо смеётся, качая головой."

    scene brooklynhallintro (10) with dissolve

    b "Ладно, но… многого не жди."

    scene intro 0 with fade

    "Она делает глубокий вдох, её пальцы находят начальный аккорд. Мелодия простая, но идущая от самого сердца — смесь надежды и тоски, которая, кажется, говорит без слов. Ты смотришь, как она растворяется в музыке: глаза закрыты, тело слегка покачивается в такт."

    "Когда она заканчивает, между вами повисает тишина, пропитанная эхом последних нот."

    scene brooklynhallintro (10) with fade

    mc "Я не понимаю, почему ты к себе так придираешься. Это было красиво."

    scene brooklynhallintro (2) with dissolve

    "Её щёки заливает blush, она отводит взгляд, а на губах играет смущённая улыбка."

    b "Ты просто льстишь."

    mc "Вовсе нет."

    "Она неловко дергает ремень гитары, явно не привыкшая к повышенному вниманию."

    scene brooklynhallintro (11) with dissolve

    b "Спасибо. Просто… ну не знаю. Я толком ни для кого никогда не играла."

    mc "А надо бы. Ты круто играешь, Бруклин."

    scene brooklynhallintro (12) with dissolve


    scene brooklynhallintro (4) with dissolve
    "Она открывает рот, чтобы ответить, но хохот, раздавшийся дальше по коридору, разрушает этот момент."

    "Вы оба поворачиваетесь и видите группу учеников вокруг высокого темноволосого парня с уверенной улыбкой. Он держит чехол от гитары и живо жестикулирует, что-то рассказывая. В нём есть то легкомысленное обаяние, которое без труда притягивает людей."

    scene brooklynhallintro (13) with dissolve
    "Всё поведение Бруклин мгновенно меняется. Её плечи напрягаются, она уттыкается в струны, неритмично брякая по ним."

    mc "Эй… ты в порядке?"

    "Она быстро кивает, но очевидно, что это не так."

    b "Да. Всё нормально."

    scene brooklynhallintro (4) with dissolve

    "Ты следишь за её взглядом, направленным на парня. Тот снова смеётся, его голос разносится по всему коридору. Девчонки вокруг него ловят каждое слово."

    scene brooklynhallintro (13) with dissolve

    mc "Ты… знаешь его?"

    "Она отвечает не сразу, её пальцы двигаются всё быстрее."

    b "Это Хавьер. Он… его все знают."

    "Ты снова переводишь взгляд на неё, замечая, как слегка дрожат её руки."

    mc "Он… тебе нравится?"

    scene brooklynhallintro (14) with dissolve

    "Она резко вскидывает голову с wide раскрытыми глазами."

    scene brooklynhallintro (15) with dissolve

    b "Что? Пфф, нет! В смысле… нет."

    "Ты изогнул бровь, выжидая. Она отворачивается, ее голос падает."

    scene brooklynhallintro (16) with dissolve

    b "Ладно. Может быть. Но это не имеет значения. Он никогда не посмотреть на такую девчонку, как я."

    mc "Это ещё почему?"

    "Она издаёт смешок, но в нём нет ни капли веселья."

    scene brooklynhallintro (6) with dissolve

    b "Посмотри на него. Уверенный, талантливый… всё то, чем я не являюсь. А я просто… я."

    "Её слова бьют сильнее, чем ты ожидал. Ты чувствуешь смесь эмоций — сочувствие, досаду, может, даже укол ревности — но глушишь всё это в себе."

    mc "Это неправда. Ты талантливая, Бруклин. С тобой круто общаться, и ты можешь дать куда больше, чем сама думаешь."

    scene brooklynhallintro (9) with dissolve

    "Она выдавливает слабую улыбку, но не выглядит убеждённой."

    mc "А что если… я помогу тебе познакомиться с ним получше?"

    scene brooklynhallintro (7) with dissolve

    "Её глаза расширяются, на лице вспыхивают удивление и надежда."

    b "Ты… ты правда это сделаешь?"

    mc "Конечно. Почему бы и нет? Ему повезёт сойтись с тобой."
    scene brooklynhallintro (10) with dissolve

    "Она смотрит на тебя, её взгляд смягчается."
    stop music fadeout 1.0
    b "Спасибо, [mcname]. Правда."
    $ unlock_event(Brooklyn, "Secret Crush", "brooklyn_hallway_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ brooklynhallintro += 1
        $ Brooklyn.affection += 1
        $ Brooklyn.quest = "Бруклин работает в кафе в ТЦ. Навести её утром в выходные!"

        "{i}Привязанность Бруклин увеличена.{/i}"

        jump weekday_evening



label brooklyn_cafe_intro:


    play music "audio/Music/Cafe.mp3" volume 0.75 fadein 1.0
    scene cafe with fade

    "Ты толкаешь дверь в «Koala Café», встречая тёплый аромат кофе и свежей выпечки."

    "Место биком забито, каждый столик занят, а в воздухе стоит непрерывный гул разговоров."

    scene brooklyncafeintro (3) with dissolve
    "Ты пробираешься к стойке, где замечаешь Бруклин, метающуюся между заказами."

    "Она предельно собрана, едва поднимая взгляд, когда принимает очередной заказ. Когда подходит твоя очередь, она откликается не сразу."

    b "Добро пожаловать в «Koala Café». Что будете заказать?"

    mc "Только смотри не исковеркай моё имя на стаканчике, ладно? Не хотелось бы стать каким-нибудь «Марком»."
    scene brooklyncafeintro (2) with dissolve

    "Она замирает на полуслове, резко вскидывая голову. В её глазах вспыхивает узнавание, сменяющееся искренней улыбкой."

    scene brooklyncafeintro (4) with dissolve

    b "О, это ты."

    mc "Собственной персоной."

    "Она закатывает глаза, но на лице видна лёгкая усмешка."

    b "Ты заказать что-то хочешь или просто пришёл мне мозг выносить?"

    mc "Всего понемногу, пожалуй."

    "Она качает головой, но улыбка не сходит с её лица."

    b "Ладно. Что будешь?"

    mc "Удиви меня. Желательно чем-то, от чего я не отброшу коньки."

    scene brooklyncafeintro (7) with dissolve

    "Бруклин отправляется готовить твой заказ, её руки действуют ловко и сноровисто. Ты опираешься на стойку, наблюдая за ее работой."

    mc "Не ожидал встретить тебя за работой здесь."

    "Она мешкает, ее движения замедляются. На мгновение тебе кажется, что она замять тему, но она лишь вздыхает."

    b "Тогда это… казалось отличной идеей."

    mc "Это как же?"

    scene brooklyncafeintro (6) with dissolve

    "Прежде чем она успевает ответить, взрыв хохота из другого конца кафе привлекает ваше внимание."

    scene brooklyncafeintro (9) with dissolve

    "Ты поворачиваешься и видишь Хавьера, снова окружённого поклонницами — на этот раз стайкой официанток, ловящих каждое его слово."


    scene brooklyncafeintro (5) with dissolve
    "Плечи Бруклин понуро опускаются, она поворачивается к стойке, делая вид, что полностью занята твоим напитком."

    b "Он приходит сюда каждые выходные. Я думала… если буду работать тут, у меня появится шанс с ним поговорить."
    b "Но оказалось, всем остальным пришла в голову точно такая же мысль. Так что теперь я просто… пашу."

    "Она ставит твой стакан на стойку, избегая твоего взгляда."

    mc "Бруклин…"

    "Она качает головой, выдавливая улыбку, которая не касается её глаз."

    b "Всё нормал. Правда. Теперь я тут тупо ради денег."

    "Ты видишь, как сильно её это задевает и как она пытается это скрыть. На мгновение ты задумываешься, что сказать. И тут тебя озаряет."

    mc "Ну, если тебе от этого станет легче, я слышал, что местный персонал славится тем, что вечно путает заказы."

    scene brooklyncafeintro (4) with dissolve

    b "Да неужели?"

    mc "Ага. Полный провал. Почти уверен, что предыдущему чуваку налили «кофе на овсяном» вместо «миндального чая». Катастрофа века."

    "Тихий смешок вырывается у неё, и ты замечаешь, как напряжение спадает с её плеч."

    b "Ну ты и гад."

    mc "Эй, я просто передаю то, что слышал."


    b "Что ж, может, мне тоже стоит испортить твой заказ. Специально."

    mc "Ты не посмеешь."

    b "А ты проверь."

    "Вы оба смеётесь, и на миг тяжесть её переживаний развеивается."

    "Она бросает еще один взгляд на Хавьера, но когда снова смотрит на тебя, её вид кажется куда более беззаботным."

    b "Спасибо. Мне… это было нужно."

    mc "Обращайся."
    stop music fadeout 1.0 
    $ unlock_event(Brooklyn, "The Koala Cafe", "brooklyn_cafe_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ brooklyncafeintro += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Бруклин увеличена.{/i}"
        $ Brooklyn.affection += 1
        $ Brooklyn.quest = "Поговори с Бруклин после уроков."
        jump cafe2noon_example


label brooklynhallevents:
    if storydream1 == 1 and storydream2 == 0:
        jump listen_to_brooklyn
    elif brooklynhallintro == 0:
        jump brooklyn_hallway_intro
    elif brooklyncafeintro == 1 and brooklyntalent1 == 0:
        jump brooklyn_talentshow_intro
    else:
        jump listen_to_brooklyn

label brooklyncafeevents:
    if brooklyncafeintro == 0:
        jump brooklyn_cafe_intro
    elif brooklyntalent1 == 1 and brooklyntalent2 == 0:
        jump brooklyn_cafe_talentshow
    else:
        jump cafe2morning_example

label brooklyn_talentshow_intro:

    scene hallway with fade
    play music "audio/Music/brooklyn.mp3" fadein 1.0

    "После уроков коридор почти пуст. Из дальних кабинетов доносятся обрывки голосов, но здесь тихо, даже умиротворённо."

    scene brooklyntalentshow (1) with dissolve

    "Ты замечаешь Бруклин на её обычном месте в самом тихом конце коридора."

    "Она сидит, скрестив ноги, у стены, гитара удобно устроилась на её коленях. Она выводит медленный, задумчивый мотив, эхом отскакивающий от шкафчиков."

    mc "О, вот ты где. Как обычно прячешься от послешкольного хаоса?"

    scene brooklyntalentshow (2) with dissolve

    "Она поднимает взгляд, не прекращая бренчать, и убирает прядь волос за ухо."

    scene brooklyntalentshow (5) with dissolve

    b "Возможно. Когда все сваливают, становится тише. Это помогает думать."

    scene brooklyntalentshow (13) with dissolve

    "Она слегка пожимает плечами, прежде чем снова уткнуться в струны."
    b "К тому же мне нужно было немного перевести дух перед уходом домой."

    scene brooklyntalentshow (14) with dissolve

    "Ты подходишь и встаёшь рядом, опершись спиной о холодную стену."

    scene brooklyntalentshow (15) with dissolve

    mc "Не могу тебя винить. На последнем уроке у меня чуть мозги не закипели."

    "Она тихо хихикает, не отводя глаз от грифа."

    b "Честно? Судя по тому немногому, что я о тебе знаю, ты не особо похож на зубрилу."

    scene brooklyntalentshow (11) with dissolve

    mc "Ты говоришь это сейчас, но просто подожди экзаменов — я каким-то чудом сдам всё на отлично."

    b "То есть под давлением в тебе просыпается ботаник?"

    scene brooklyntalentshow (7) with dissolve

    mc "Да не, просто удача адовая."
    b "И это реально работает? Что-то не верится."

    scene brooklyntalentshow (15) with dissolve

    mc "Ты права. У меня есть секретный прием."
    mc "Перед каждым тестом я молюсь вообще всем богам, которых помню."
    mc "Христианскому, мусульманскому, буддийскому, да блин, даже греческим и римским."

    scene brooklyntalentshow (14) with dissolve

    mc "И пока это срабатывает, так что как минимум один из них точно прикрывает мою задницу."

    "Бруклин фыркает от твоего сарказма."
    b "Думаю, лучше перестраховаться, чем потом жалеть."
    "Она слабо улыбается этим словам, продолжая играть."

    scene brooklyntalentshow (13) with dissolve

    "Её пальцы двигаются изящно, ноты звучат мягко и с грустинкой. Ты ловишь себя на том, что слушаешь куда внимательнее, чем собирался."

