default noragymintro = False
default noracityintro = False


label nora_intro:
    stop ambient fadeout 1
    scene intro 0 with fade
    pause 2
    scene noraintro with fade
    "Ты замечаешь Нору за её партой: всё её внимание полностью поглощено телефоном."
    "Свечение экрана подчёркивает её яркие черты лица — длинные ресницы, безупречно уложенные волосы..."
    "И те самые знаменитые глаза, которые сделали её любительской моделью и местной сенсацией."
    scene noraintro (1) with dissolve
    "Пьер уже дал тебе краткую характеристику её личности — громкая, дерзкая, с характером столь же ослепительным, как и её внешность."
    "Сегодня ты решаешь, что момент подвернулся подходящий, чтобы проверить, из-за чего весь сыр-бор."
    scene noraintro (2) with dissolve
    "Когда ты подходишь ближе, она внезапно поднимает взгляд и перехватывает твой взор. Выражение её лица меняется с легкого любопытства на мгновенную вспышку азарта."
    "И вдруг..."
    scene noraintro (4) with dissolve
    n "Улыбочку~!"
    scene noraintro (5) with flash
    pause 2
    mc "Ты что... только что сфотографировала меня?"
    scene noraintro (6) with dissolve
    "Она разворачивает телефон, показывая селфи, где она широко ухмыляется, а ты на заднем плане выглядишь растерянным и полусонным."
    n "Ну да! Освещение было слишком идеальным, чтобы упустить момент. Зацени!"
    mc "В восторге от роли случайного реквизита."
    scene noraintro (9) with dissolve
    "*Она хихикает — медовым звонким смехом, заставляющим нескольких человек в классе обернуться.*"
    n "Реквизита? Не-а, крошка, ты типа идеальный фон. Весь такой мрачный и загадочный~ Тотально в моём стиле!"
    "Её голос лёгкий, подразнивающий, но за её словами чувствуется искренний азарт."
    scene noraintro (8) with dissolve
    mc "Замечательно, именно к этому я и стремился, когда сполз с кровати и забыл причесаться."
    "Нора наклоняется ближе и жестом приглашает тебя сесть. Её идеальный маникюр постукивает по парте, пока она разглядывает тебя."
    scene noraintro (12) with dissolve
    n "Без шуток, это просто вау. Типа, бледная кожа, эти уставшие глаза... От тебя буквально веет вайбом трагичного красавчика. Я просто в восторге~!"
    "Ты моргаешь, не понимая, радоваться тебе комплименту или обижаться на подкол."
    mc "Трагичный красавчик, да? Запишу себе в резюме."
    scene noraintro (15) with dissolve
    n "Сделай это! Мы устроим коллаб. 'Команда мечты: Трагичный гот и Гяру', ну каково, а?"
    "Она кокетливо встряхивает волосами, заставляя браслеты на запястье звенеть."
    "Идея совместного... чего бы то ни было, вытягивает из тебя невольную улыбку."
    mc "Не думаю, что на рынке есть спрос на зомби-шик."

    scene noraintro (18) with dissolve
    "Нора хмурится и ахает так наигранно, словно ты нанёс ей смертельную обиду."
    scene noraintro (16) with dissolve
    n "Понтово-о-о?! Крошка, на горячих упырей с такими скулами, как у тебя, СПРОС ЕСТЬ ВСЕГДА. Поверь мне~"
    "Звонок извещает о начале урока, но Нора даже не чешется, вальяжно откинувшись на стуле, словно владелица этого места."
    scene noraintro (10) with dissolve
    n "Та-а-ак, а ты шутки травить умеешь, или всё ограничивается трагичными взглядами и угрюмостью?"
    mc "Шутки? Внезапный перевод темы."
    scene noraintro (17) with dissolve
    n "Значит, это 'нет'? Грустная эмодзи..."
    "Нора снова наигранно хмурится, заставляя тебя почувствовать укол вины."
    mc "Ну, думаю, могу выдать одну шутку... Только не жди высокого качества."
    scene noraintro (12) with dissolve
    "Её глаза снова загораются, будто вся эта грусть была фальшивкой."
    n "О-о-о, я готова. Давай!"
    "Ты делаешь паузу, судорожно вспоминая самую плохую шутку в своей жизни."
    scene noraintro (24) with dissolve
    mc "Почему скелет пошёл на вечеринку один?"

    "Нора подаётся вперёд, полностью сконцентрировавшись на тебе."
    mc "Потому что у него не было духа пойти с кем-то."
    scene noraintro (20) with dissolve
    n "...."
    mc "...."
    scene noraintro (21) with dissolve
    n "..."
    n "Пф-ф-ф-ф-ф-т"
    pause 2
    scene noraintro (22) with hpunch
    n "ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА"
    "Нора начинает истерически хохотать, привлекая внимание абсолютно всех в классе и заставляя тебя чувствовать себя неловко."
    "А вот Нору, похоже, общественное мнение вообще не волнует."
    scene noraintro (23) with hpunch
    n "ПРЕКРАТИ! Это типа САМАЯ СМЕШНАЯ ШТУКА НА СВЕТЕ! Я просто ору~"
    "Она смахивает слезу, всё ещё угарая, причем её макияж каким-то чудом остается безупречным."
    mc "Рад внести свой вклад в твою ежедневную дозу кринжа."

    scene noraintro (19) with dissolve
    n "Крошка, ты теперь мой новый любимчик. Реально. Угрюмый И смешной? Ты теперь от меня не отвяжешься, понял?"
    "В её голосе слышен подразнивающий тон, но в глазах мелькает неожиданная искренность."
    "Прежде чем ты успеваешь ответить, голос учителя перекрывает шум, требуя внимания к уроку."
    n "Ой, ой! Чуть не забыла — я Нора. Гяру-модель экстраординарного класса~"
    n "У меня тут небольшая съёмка в спортзале после уроков. Тебе обязательно надо заглянуть~ Просто к слову."
    "Она дарит тебе ослепительную улыбку и разворачивается к доске."
    mc "Я [mcname]. Твой местный трагичный гот, получается."
    scene noraintro (26) with dissolve
    "Она кивает, пытаясь подавить очередной смешок."
    n "Идеально. Мы тотально повеселимся, [mcname]. Поверь~"
    "Ты ощущаешь смесь озадаченности и интриги. Нора... гиперактивная, но нельзя отрицать, что впечатление она произвела яркое."
    $ unlock_event(Nora, "So Chic", "nora_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ Nora.quest = "Найди Нору в спортзале после уроков."
        $ intro_nora += 1
        $ Nora.affection += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Норы увеличена.{/i}"
        "{i}Теперь ты можешь навещать Нору в спортзале после уроков.{/i}"

        jump weekday_afternoon


label nora_gym_intro:
    scene black with fade

    scene gym with fade

    "Ты направляешься в спортзал, наполовину ожидая увидеть его пустым, но вместо этого натыкаешься на небольшую установку из софитов, отражателей и реквизита."
    "В центре всего этого стоит Нора с баскетбольным мячом и уверенно позирует. Её энергия буквально ощутима физически, заполняя всё пространство."

    "Она замечает тебя почти мгновенно, и её лицо озаряется узнаванием."
    play music "audio/Music/Nora.mp3" volume 1.0
    scene noragymintro (1) with dissolve
    n "Хэй-й! А ты реально пришёл~ Не думала, что мой трагичный гот доберётся сюда."
    mc "Ни за что бы не пропустил. Или, знаешь ли, не устоял перед обещанием новых селфи без спроса."
    scene noragymintro (2) with dissolve
    "Она смеётся, дерзко подмигивая тебе."
    n "Ой, да тебе это понравилось, и ты сам это знаешь~."
    scene noragymintro (9) with dissolve
    n "Та-а-ак, раз уж ты здесь..."
    n "Есть для меня новый материал, или всё ограничиться шутками про скелетов и мрачными взглядами?"
    "Ты скрещиваешь руки на груди, делая вид, что глубоко задумался."
    mc "Хочешь больше шуток? Осторожнее, я могу растерять последние остатки своего достоинства."
    scene noragymintro (13) with dissolve
    "Она наклоняется ближе, её улыбка широкая и выжидающая."
    n "Ну пожалуйста-а-а. Я готова~"
    "Ты тяжело вздыхаешь и начинаешь."
    mc "Ладно. Почему скелеты не дерутся друг с другом?"
    "Её взгляд сужается, в глазах пляшет любопытство."
    mc "Потому что у них кишка тонка."

    "На долю секунды повисает тишина..."
    "А затем точно так же, как и в прошлый раз."
    scene noragymintro (14) with dissolve
    n "Пф-ф-ф-т-т-т"
    pause 2
    scene noragymintro (15) with hpunch
    n "ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА-ХА"
    n "ПРЕКРАТИ! Я не могу — это так тупо! Я буквально плачу!"
    "Она вытирает слезинку из уголка глаза, всё ещё хихикая."
    "Зара на заднем плане делает фейспалм и бубнит что-то вроде 'мне недостаточно за это платят'."
    "Нора отмахивается от неё, полностью переключая внимание на тебя."
    scene noragymintro (16) with dissolve
    n "Ладно, ладно. Ты официально забрал наградную статуэтку за самую ужасную шутку. Но если seriously, спасибо. Мне нужен был этот смех~"
    mc "Даже не знаю, гордиться мне или пойти спрыгнуть с моста."

    z "Эй, Нора, я пойду на кофе-брейк."
    scene noragymintro (5) with dissolve
    n "Ну-у-у, ты чего? Зара-а-а-а, я только вошла во вкус."
    z "Не мои проблемы, надо было раньше входить."
    n "Шикарно…. И что мне теперь делать?"
    scene noragymintro (11) with dissolve
    n "Эй, погоди-ка!"
    n "Раз уж ты всё равно здесь, не хочешь сделать мне одолжение? Мне нужно пару кадров с другого ракурса. Думаешь, справишься с камерой?"
    mc "Э-э-э, ну не знаю... Качество не гарантирую."
    n "Ну пожалуйста. Вайб ты и так поймал. Просто наводи и нажимай."
    scene intro 0 with fade
    "Со смесью веселья и легкого мандража ты встаёшь так, как она показывает. Нора мгновенно переключается в режим модели, без усилий сочетая уверенность и шарм."
    scene noragymintro (17) with fade
    "Ты делаешь несколько кадров, пытаясь удержать руки от дрожи. Она чередует игривые позы с серьезными, и её энергия заразительна как никогда."
    n "Ну как там выходит? Не стесняйся, дай глянуть~"
    scene noragymintro (10) with dissolve
    "Ты подходишь и показываешь ей сделанные снимки. К твоему облегчению, она выглядит искренне довольной."
    n "Неплохо, [mcname]. Я, пожалуй, сделаю тебя своим личным фотографом."
    scene noragymintro (7) with dissolve
    z "Я вообще-то всё слышала, придурок."
    scene noragymintro (3) with dissolve
    n "Спасибо, что задержался. Серьёзно."
    mc "Заходи ещё. В смысле, кто знает? Может, меня ждёт карьера в фотографии."
    scene noragymintro (2) with dissolve
    "Она снова смеётся, на этот раз тише, но так же искренне."
    n "Я так и знала, что ты сокровище~"
    n "Кстати, если захочешь пересечься на выходных, я обычно закупаюсь в ТЦ в обеденное время."
    "Прежде чем ты успеваешь ответить, Зара зовёт её обратно на очередной сет кадров. Нора быстро машет тебе рукой и снова встаёт под софиты."
    "Ты наблюдаешь ещё мгновение, а затем направляешься к выходу, чувствуя себя странно легче, чем когда пришёл."
    $ unlock_event(Nora, "Strike a Pose", "nora_gym_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ Nora.quest = "Найди Нору в торговом центре на выходных днем."
        $ Nora.affection += 1
        $ noragymintro += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Норы увеличена.{/i}"
        "{i}Теперь ты можешь тусоваться с Норой по выходным в торговом центре в дневное время.{/i}"

        jump weekday_evening



label nora_mall_intro:

    scene mall with fade

    "В торговом центре, как обычно, многолюдно. Покупатели снуют между магазинами, их голоса сливаются в гулкий фоновый шум."
    "Ты бесцельно прогуливаешься, когда знакомый голос прорезает этот гул, звуча слегка надрывно."

    n "Угх! Серьёзно?! Да ладно вам…"
    play music "audio/Music/Nora.mp3" volume 1.0

    scene noramallintro (1) with fade

    "Ты поворачиваешься на звук и замечаешь Нору, стоящую посреди прохода. Её руки буквально завалены пакетами."

    scene noramallintro (2) with dissolve
    "Каждый пакет забит до отказа, а на её лице застыла смесь решимости и легкого отчаяния."

    scene noramallintro (4) with dissolve
    "Она замечает тебя мгновенно, и её глаза загораются, несмотря на всю тяжесть её положения."

    n "О-мой-бог! [mcname]! Ты типа мое спасение прямо сейчас!"

    "Она дарит ослепительную улыбку, перекладывая тяжесть пакетов с наигранным вздохом."

    mc "Проблемы на таможне?"

    scene noramallintro (5) with dissolve

    "Она дуется, глядя на яркое разнообразие пакетов, свисающих с её рук."

    n "Совсем чуть-чуть. Кажется, я... слегка переборщила. Но распродажи! Ты должен меня понять~"

    "Ты приподнимаешь бровь, скрещивая руки."

    mc "И что теперь? Тебе нужен вьючный мул?"

    scene noramallintro (4) with dissolve

    n "Именно! Ты всё понял! Давай, трагичный красавчик, спасай девушку!"

    "Ты вздыхаешь, но подходишь ближе и забираешь часть пакетов. Их вес удивляет тебя: такое ощущение, что она скупила половину ТЦ."

    mc "Ты что накупила-то вообще? Кирпичи?"

    scene noramallintro (6) with dissolve
    n "Обувь, шмотки, аксессуары… Всё, что нужно гяру, чтобы оставаться шикарной. Тяжела корона из блесток, крошка~"

    "Забрав часть ее багажа, вы вместе направляетесь к скамейке."

    scene intro 0 with fade

    "Нора сбрасывает оставшиеся пакеты с драматичным вздохом, потягивая руки над головой."

    scene noramallintro (8) with fade

    n "Ты мой спаситель, [mcname]. Серьёзно. Я думала, мне придется ползти домой на четвереньках."

    mc "Рад предотвратить травму, связанную с шопингом."

    n "Ну и как твои мрачные готические будни? Не ожидал, что тебя затянет в хаос моей шопинг-терапии, а?"

    mc "В моем расписании этого точно не было."

    n "Ну, считай это эксклюзивным маршрутом. И, знаете ли… раз уж мы здесь…"

    n "Ладно, ладно. Последнее одолжение, трагичный красавчик. Раз уж ты всё равно тут… не поможешь донести всё это до следующего магазина? Клянусь, он последний. Честно-честно~"

    "Ты смотришь на гору пакетов, затем на её умоляющее лицо. Трудно сказать 'нет', когда она смотрит на тебя вот так."

    mc "Только если пообещаешь не скупать весь магазин на этот раз."

    n "Никаких гарантий~"

    scene intro 0 with fade

    "Вы вдвоём идете по торговому центру, её смех перекрывает шум толпы, пока она болтает без остановки."

    "Шопинг с Норой — это... отдельный вид испытания. Но ты не можешь сдержать улыбку."
    $ unlock_event(Nora, "Heavy is the Sparkly Head", "nora_mall_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ Nora.quest = "Подними уровень привязанности с Норой, затем встреть её в ТЦ."
        $ noramallintro += 1
        $ Nora.affection += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Норы увеличена.{/i}"

    jump mall1evening_example

label noragymevents:
    if storydream1 == 1 and storydream2 == 0:
        jump gym_photos_for_nora
    elif noragymintro == 0:
        jump nora_gym_intro
    else:
        jump gym_photos_for_nora

label noramallevents:
    if noramallintro == 0:
        jump nora_mall_intro
    elif Nora.affection >= 5 and totaldays >= 10 and nora5event == 0:
        jump nora_5_event
    else:

        jump nora_menu


label nora_5_event:

    play ambient "audio/ambient/Mall.mp3" volume 0.5
    scene mall with fade
    "Ты бродишь по торговому центру, разглядывая витрины и покупая кое-какие мелочи."
    play music "audio/Music/Nora.mp3" volume 1.0 fadein 1.0
    scene noramall1 with dissolve
    "Ты замечаешь Нору, которая занимается шопингом с полной охапкой пакетов."

    n "О-мой-бог! Посмотри на это, боже, эти пакеты такие тяжелые"
    scene noramall2 with dissolve
    "Она ухмыляется тебе, а затем переводит взгляд на свою растущую кучу покупок."

    n "Приветули-и-и! Слушай, не мог бы ты сделать мне огромную одолжение? Эти пакеты ну просто о-о-очень тяжелые!"
    "Она состряпала милую рожицу и вручает тебе пакеты еще до того, как ты успеваешь что-либо ответить."
    scene norahmall with fade

    scene black with fade

    "Ты забираешь пакеты и плетешься за ней, пока она залетает в каждый магазин, болтая о моде без остановки."
    "Обойдя весь торговый центр с пакетами Норы, вы оба решаете сделать перерыв."
    scene nora5event (1) with fade

    "Вы с Норой садитесь на скамейку прямо посреди торгового центра."

    "Нора разваливается рядом с тобой, откидывая голову назад с драматичным стоном, будто ее только что тащили через пустыню."

    n "Угх-х-х, я, походу… *реально умерла*, [mcname]."

    mc "Да ну? Должно быть, ужасно утомительно наблюдать за тем, как я таскаю весь твой гардероб по трем этажам."

    scene nora5event (2) with dissolve

    "Она вяло машет рукой на пакеты, будто они ее лично оскорбили."

