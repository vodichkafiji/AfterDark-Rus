            scene junealley (62) with dissolve
            isa "Ты ни с кем не будешь говорить об этом."
            isa "И ты будешь держаться подальше от моей сестры."
            scene junealley (63) with dissolve
            isa "Если я увижу тебя рядом с ней снова, я не буду столь мягким."

            "Он поворачивается, его голос слегка смягчается — но лишь слегка."
            scene junealley (66) with dissolve
            isa "Пошли, Люси. Мама и папа ждут."
            isa "Нам многое нужно обсудить."
            scene junealley (67) with dissolve
            "Глаза Джун наконец встречаются с твоими на долю секунды."
            "Страх. Вина. Безмолвное извинение."
            "Затем она отворачивается и идет за ним без единого слова."

            scene black with dissolve
            "Ты смотришь, как они уходят. Исайя открывает перед ней пассажирскую дверь чистой чёрной машины."
            "Она садится без сопротивления."
            play sound "audio/Sound/car.mp3"
            scene junealley (68) with dissolve
            "Машина тихо отъезжает."
            scene junealley (69) with dissolve
            "Ты остаешься стоять один в подворотне, его слова всё ещё висят в воздухе."
            "Кусочки пазла начинают складываться — прятки, макияж, страх в её глазах, когда она увидела тот крест."
            scene junealley (73) with dissolve
            mc "(Люси… нет, Джун...)"
            mc "(Её семья… они…)"

            mc "(...)"
            scene junealley (74) with dissolve
            mc "(Пиздец.)"
            mc "(Она пряталась от них всё это время.)"
            mc "(Неудивительно, что у неё проблемы с доверием...)"
            scene junealley (73) with dissolve
            mc "(Мне нужно поговорить с ней.)"
            mc "(Я должен знать, что с ней всё в порядке.)"
            $ unlock_event(June, "Who's Lucy?", "june_alley_confrontation")
            if _in_replay:
                $ renpy.end_replay()
            else:
                $ junebrotherintro += 1
                $ June.quest = "Иди на занятия на следующий день."
                jump weekday_evening

label junehelp:
    scene schoolentrance with dissolve
    "Ты поспешно направляешься в класс."
    play music "audio/Music/School.mp3" volume 1.0
    play ambient "audio/ambient/crowd.mp3" volume 0.3
    scene classroom with fade
    scene black with fade

    "Ты сидишь в классе, уже забыв, что должен был читать."
    scene junehelp (1) with dissolve
    "Твой разум никак не может отвлечься от кого-то на краю твоего зрения."
    scene junehelp (2) with dissolve
    "Джун сидит на заднем ряду."

    "Сказать, что она выглядит хреново, было бы комплиментом в данный момент."

    "Очевидно, всё, что произошло между ней и её братом, оставило её в полном растрепе."
    scene junehelp (3) with dissolve
    mc "(Чёрт, и подумать только, что это всё моя вина.)"

    mc "(Мне нужно поговорить с ней как можно скорее.)"
    scene junehelp (4) with dissolve
    mc "(...)"

    mc "(На данном этапе стоит попробовать.)"
    scene junehelp (10) with dissolve

    "Ты достаёшь запасной листок бумаги и начинаешь выводить записку."

    "{i}«Эй, мне жаль из-за того, что произошло. Исайя... он что-то сделал?»{/i}"

    scene junehelp (6) with hpunch
    play sound "audio/sound/paperball.mp3"
    "Ты сминаешь записку в шарик и бросаешь её в сторону Джун."
    scene junehelp (7) with dissolve
    "Она бросает быстрый взгляд на то, что ты написал."
    scene junehelp (8) with hpunch
    "Прежде чем немедленно показать тебе средний палец."

    mc "(Ургх, похоже, она всё ещё в бешенстве на меня.)"
    scene junehelp (9) with dissolve
    "{i}«Мне плевать, если ты злишься на меня. Мне просто нужно знать, в безопасности ли ты.»{/i}"

    "{i}«Думаю, я хотя бы заслуживаю объяснения, да?»{/i}"
    play sound "audio/sound/paperball.mp3"
    scene junehelp (6) with hpunch

    "Ты бросаешь вторую записку. На этот раз она приземляется прямо на её открытый учебник."
    scene junehelp (12) with dissolve
    "Джун читает её более внимательно на этот раз."

    "Её выражение лица начинает меняться на что-то, что трудно прочесть."

    scene junehelp (13) with dissolve
    "Она поднимает взгляд на тебя, словно чтобы получить ответ."
    scene junehelp (15) with dissolve
    "Но затем сползает обратно на стул."
    scene junehelp (16) with dissolve
    j "Учитель, можно мне в туалет?"
    scene junehelp (17) with dissolve
    "Джун проходит мимо твоей парты по пути к двери."
    play sound "audio/sound/paperball.mp3"
    scene junehelp (18) with dissolve

    "Проходя мимо, она роняет записку рядом с тобой."
    scene junehelp (19) with dissolve
    "Стараясь не выглядеть отчаявшимся, ты немедленно подбираешь её."
    play sound "audio/sound/paper.wav"
    show notea with dissolve
    "Записка испещрена её привычным хаотичным почерком."

    "{i}«Подожди 5 минут, а потом тоже отпросись в туалет.»{/i}"
    scene junehelp (20) with dissolve
    mc "(Ну, это хотя бы что-то.)"
    stop ambient
    play music "audio/music/june.mp3"
    scene black with fade

    "Ты делаешь то, что она тебе сказала, и снова находишь её возле шкафчиков."

    scene junehelp (21) with hpunch

    j "Так о чём ты хотел поговорить, а!?"

    j "Да, я грёбаное фальшивка, окей!"
    scene junehelp (22) with hpunch
    j "Да, я из семьи психопатов."

    j "И да, я вспыхнула на тебя из-за какого-то глупого креста!"
    scene junehelp (23) with hpunch
    j "У меня всё ещё есть право злиться на тебя за то, что ты шпионил за мной!"

    j "И ничто из того, что ты сделаешь или скажешь, этого не исправит."

    mc "..."

    j "..."

    mc "Я рад, что ты всё ещё злишься."

    mc "Это значит, что тебе всё ещё не всё равно."

    mc "Тебе всё ещё не всё равно, что я накосячил, вместо того чтобы забить вообще на всё..."
    scene junehelp (21) with dissolve

    j "..."

    j "Перестань быть ханжой."
    scene junehelp (29) with dissolve
    mc "Ты… в порядке?"

    j "..."

    j "Почему тебя это волнует?"




    mc "Он...{w}ну..."
    scene junehelp (21) with dissolve

    j "Нет, он меня, блядь, не бил, [mcname]."
    scene junehelp (23) with dissolve
    j "Это ведь то, что ты собирался спросить?"
    scene junehelp (21) with dissolve
    j "Блядь... было бы куда проще, если бы ударил..."

    j "Тогда бы у меня хотя бы был нормальный повод вызвать полицию на свою семейку."

    j "Вместо этого мне приходится слушать о том, как я подвожу весь дом."

    j "Или что я создаю проблемы, которые не стоят этой обузы."

    scene junehelp (22) with dissolve
    j "А если они посчитают, что моё извинение не искреннее?"

    j "Они отправят Исайю «исправить» проблему."
    scene junehelp (26) with dissolve
    j "..."

    j "Я говорила тебе, что у меня раньше были друзья, помнишь?"

    j "Люди, которым я нравилась такой, какая я есть—"
    scene junehelp (25) with dissolve
    j "Люди, которые позволяли мне гулять и быть собой!"

    j "Я знала их годами, пока моя семья не узнала, что они «плохая компания»."

    j "И они..."
    scene junehelp (29) with dissolve
    j "..."

    j "На следующий день они даже не смотрели на меня."
    scene junehelp (27) with dissolve
    j "Я была ребёнком, и с тех пор я knew, что у меня всегда будет свой личный Судный День, если я не буду идеальной дочерью..."

    j "Так что я решила, что в школе я буду собой."
    scene junehelp (21) with dissolve
    j "Я буду подальше от них, и я смогу быть настолько свободной и нормальной, насколько это возможно."

    j "Я смогу решать, кто я, что люди думают обо мне."
    scene junehelp (26) with dissolve
    j "Без того, чтобы кто-то нависал надо мной с бреднями о том, что я буду проклята и отправлюсь в ад, если не буду жить той жизнью, которую они для меня хотят."

    j "Чёрт, я даже начала говорить, что хожу на изучение Библии по выходным, чтобы они отъебались от меня и тогда."
    scene junehelp (23) with dissolve
    "Всё это обрушивается на тебя разом. Это всё, что ты хотел от неё услышать."

    "Но в то же время в комнате остаётся слон, которого невозможно не заметить."

    mc "Почему...{w} Почему он назвал тебя Люси?"
    scene junehelp (21) with dissolve
    j "..."

    j "Это имя, которое они мне дали."

    j "Меня назвали в честь Святой Люсии."
    scene junehelp (22) with dissolve
    j "Какая-то христианская девчонка, которая стала мученицей в Риме или типа того."

    j "Я ненавижу это, люди даже не понимают, что оно религиозное, когда знакомятся со мной."
    scene junehelp (23) with dissolve
    j "Но я-то знаю."

    j "И моя семья знает."
    scene junehelp (29) with dissolve
    j "Я knew, что заваливаю уроки, и если я не хотела, чтобы они узнали, мне нужно было взяться за другое имя."

    j "Так что... я сменила на Джун."
    scene junehelp (28) with dissolve
    j "Потому что это месяц, в котором я родилась."

    j "Это простое имя без смыслов и привязок."
    scene junehelp (27) with dissolve
    j "Но это то имя, которое выбрала я."

    j "И в нём куда больше меня, чем в Люси когда-либо было."
    scene junehelp (24) with dissolve
    j "Но теперь всё потенциально разрушено."

    j "Моя семья думает начать сильнее копать под школу."
    scene junehelp (29) with dissolve
    j "Если они узнают, кто я... и чем занималась."

    mc "Что самое худшее может случиться? Они выгонят тебя из дома?"
    scene junehelp (23) with dissolve
    j "Да я бы мечтала, чтобы они выгнали меня из дома!"

    j "Они просто будут контролировать меня ещё жестче."
    scene junehelp (25) with dissolve
    j "Я потеряю единственную свободу, которая у меня когда-либо была..."

    mc "Эй, до этого ещё не дошло."
    play sound "audio/sound/pants.mp3" 
    scene junehelp (30) with dissolve

    "Ты протягиваешь руки, заключая её в объятия. Она моментально деревенеет, отталкивая."

    j "[mcname]..."


    mc "Я не отпущу, Джун."
    scene junehelp (31) with dissolve

    j "[mcname], прекрати."

    mc "Ты не «Люси» для меня. И ты не обуза."

    mc "Тебе не нужно быть кем-то другим для меня прямо сейчас. Тебе просто нужно быть собой."
    play sound "audio/sound/hoodie.wav" 
    scene junehelp (32) with dissolve
    "Впервые она не «пугающая девчонка» с задней парты и не «крутая бунтарка» из подворотни."
    "Она просто Джун. И она наконец позволяет кому-то помочь ей нести этот груз."
    scene junehelp (34) with dissolve
    j "Бля...{w} У меня сейчас макияж потекёт."

    mc "Вот это реально катастрофа, учитывая, что я видел, сколько времени уходит на то, чтобы его нанести."
    scene junehelp (35) with dissolve
    j "Пфффф, заткнись..."

    mc "Всё будет хорошо, Джун."
    scene junehelp (33) with dissolve
    j "{size=-2}Нифига не хорошо... никогда всё не будет хорошо...{/size}"

    mc "Может, не сегодня. Но всё будет в порядке, потому что мы со всем этим разберёмся. Я обещаю."
    scene junehelp (36) with dissolve

    "Она прячет лицо у меня на плече."

    j "Ты прощён,{w} пока что."

    mc "Какое облегчение."

    mc "Пойдём обратно в класс, пока люди не подумали, что мы прогуливаем."
    $ unlock_event(June, "Crossed Signals", "junehelp")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ June.quest = "Подожди до ночи."
        play sound "audio/Sound/affection.mp3"
        "{i}Привязанность Джун значительно увеличена.{/i}"
        $ June.affection += 5
        play music "audio/music/school.mp3"
        $ junehelp += 1
        jump weekday_afternoon













label june_panick:
    stop music fadeout 2.0
    play sound "audio/sound/notification.mp3"
    scene weekdaybedroomnight_bg with dissolve
    play ambient "audio/ambient/Night.mp3" volume 0.3
    "Ты получаешь голосовое сообщение на телефон."
    j "{i}Это Джун, пожалуйста, приходи в переулок. Срочно.{/i}"
    mc "Джун? Чего она хочет?"

    mc "{i}Типа...{w}прямо сейчас?{/i}"

    j "{i}Да.{/i}"
    mc "..."
    mc "Сейчас около 11 вечера...{w}разве она не должна быть с родителями?"

    mc "Если только что-то..."

    mc "..."

    mc "{i}Уже бегу.{/i}"

    j "..."

    j "{i}Пожалуйста, побыстрее.{/i}"

    mc "Чёрт...{w}Что, блядь, происходит?"
    scene black with dissolve
    stop ambient fadeout 1.0
    play sound "audio/ambient/running.mp3"
    "Ты спешишь к заброшенному зданию, куда Джун уже приводила тебя однажды, судорожно восстанавливая маршрут в памяти."
    stop sound fadeout 1.0
    "Как только ты добираешься до фасада здания, Джун немедленно выходит тебе навстречу."

    play music "audio/Music/sad.mp3" volume 1.0

    scene juneclimax1 (1) with dissolve
    "Её волосы растрёпаны, дыхание рваное, а чёрная помада смазана так, будто она в панике терла лицо."

    mc "Джун? Что за херня—"

    j "О боже...{w} О чёрт...{w} [mcname], мы в таком пиздорезе...{w} Нам просто, блядь, конец."
    scene juneclimax1 (1) with hpunch
    mc "Тормози!"
    mc "Что случилось?"
    mc "Копы нашли твой дом? Исайя—"
    scene juneclimax1 (12) with dissolve
    j "Ещё нет! Но они найдут!"

    j "Посмотри на это!"
    play sound "audio/sound/hoodie.wav"
    scene juneclimax1 (11) with hpunch
    "Она суёт свой телефон тебе в лицо, её рука дрожит настолько сильно, что экран расплывается в сплошную мазню."
    "На нём паблик районного патруля крутит видеозапись."
    "Она в высоком качестве, запись из скейт-парка."
    "Это...{w} ошибочно узнаваемо."
    "Каждый штрих баллончиком, каждый смешок и чёткий вид обоих лиц, когда вы разворачиваетесь, чтобы бежать от сирен."
    scene juneclimax1 (6) with dissolve
    mc "Ладно... ладно, это плохо."

    mc "Но, Джун, это просто граффити."

    mc "Нам выпишут штраф. Может, ещё немного общественных работ..."

    mc "Это не конец света."
    scene juneclimax1 (2) with hpunch
    j "ТЫ НЕ ПОНИМАЕШЬ!"

    "Она смотрит на тебя как загнанный в клетку зверь."

    j "Для тебя это ебучий штраф!"
    scene juneclimax1 (2) with hpunch
    j "Для меня это конец всему!"
    scene juneclimax1 (3) with dissolve
    j "Исайя и так уже подозревал неладное."

    j "Он следит за мной как ястреб с тех пор, как мы вернулись домой."
    j "Если полиция постучит в ту дверь и покажет моему отцу эту запись..."
    scene juneclimax1 (4) with dissolve
    j "Они не просто разозлятся, [mcname]."
    j "Я больше никогда тебя не увижу."
    scene juneclimax1 (6) with dissolve
    j "У них есть этот... этот «Ретрит». Лагерь на севере. Никаких телефонов. Никакой музыки. Только «духовное исцеление»—"

    j "Меня не будет. Месяцами. Может, годами."
    scene juneclimax1 (7) with hpunch
    j "БЛЯДЬ!"

    j "Мне ПИЗДЕЦ! Из этого нет никакого выхода!"
    scene juneclimax1 (8) with dissolve
    j "Я сойду с ума! Я, блядь, умру в этом месте!"
    j "Я-Я-Я..."
    scene juneclimax1 (9) with dissolve
    j "Я-Я не знаю, что делать, я просто—"

    j "Чёрт."
    scene juneclimax1 (10) with dissolve
    "Джун начинает рыдать и трястись, практически гипервентилируя сквозь слёзы."

    mc "(Я никогда не видел её такой...)"
    play sound "audio/sound/hood.mp3"
    scene juneclimax1 (13) with dissolve
    mc "Джун, посмотри на меня. Дыши."

    "Ты хватаешь её за плечи. Она дрожит настолько сильно, что ты чувствуешь это собственными костями."
    scene juneclimax1 (14) with dissolve
    mc "Всё нормально. Я здесь с тобой."
    scene juneclimax1 (15) with dissolve
    j "..."

    scene juneclimax1 (16) with dissolve
    j "Мы должны всё исправить. Должны."

    j "Если этот файл исчезнет... у полиции ничего не будет."
    scene juneclimax1 (17) with dissolve
    j "Пост удалят из-за «нехватки улик». Всё просто испарится, так ведь?"

    mc "Я... я не знаю, Джун."
    scene juneclimax1 (18) with dissolve
    j "Мы должны попробовать! Если мы проберёмся на участок, мы сможем удалить её."
    mc "Ты хочешь, чтобы мы забрались в полицейский участок?"

    mc "В место, где, знаешь ли...{w} ВСЯ ПОЛИЦИЯ?"
    scene juneclimax1 (20) with dissolve
    j "У них не хватает людей по выходным! Большинство из них на патрулировании!"

    j "Пожалуйста, [mcname]...{w} Я умоляю тебя, ладно."

    j "Я не могу поехать в этот лагерь. Я умру там. Я знаю, что умру."
    scene juneclimax1 (19) with dissolve
    "Она смотрит на тебя, слёзы вот-вот потекут по густой подводке."
    "Это не просьба. Это отчаянный крик о помощи."

    scene juneclimax1 (21) with dissolve
    j "Я...{w} Я знаю, где находится серверная."
    scene juneclimax1 (20) with dissolve
    j "По крайней мере...{w} думаю, что знаю..."
    scene juneclimax1 (22) with dissolve
    j "У Исайи есть друзья в полиции. Он приводил меня туда пару раз."

    j "Она в подвале. Рядом с комнатами вещественных доказательств."

    mc "В подвале. Ну разумеется."
    scene juneclimax1 (23) with dissolve
    j "Пожалуйста, [mcname]. Ты единственный человек, которому я могу доверять."
    scene juneclimax1 (19) with dissolve
    j "Единственный, кто знает...{w} обеих меня."


    mc "..."

    mc "Ладно."

    mc "Ладно, да.{w} Мы сможем сделать это."

    mc "Мы составим план и попытаемся проникнуть в участок на выходных."
    scene juneclimax1 (24) with dissolve
    j "..."
    scene juneclimax1 (25) with dissolve
    j "[mcname], я..."
    scene juneclimax1 (26) with dissolve
    j "Спасибо тебе за то, что делаешь это."

    scene juneclimax1 (27) with dissolve
    "Она грубо вытирает глаза тыльной стороной рукава, пытаясь собраться с силами."

    j "Я знаю, что в последнее время была конченой стервой по отношению к тебе… но спасибо."

    mc "Всё будет в порядке, Джун, я с тобой."

    mc "Мы теперь в этом вместе. Мы со всем разберёмся."
    play sound "audio/sound/hoodie.wav"
    scene juneclimax1 (28) with dissolve
    "На миг Джун прижимается лбом к твоей груди, судорожно дыша."

    j "{size=-2}Мне так страшно…{/size}"

    mc "..."
    stop music fadeout 1.0
    scene black with dissolve
    mc "Я с тобой."

    "Ты умалчиваешь о том, что тебе тоже страшно."

    $ unlock_event(June, "It's Over", "june_panick")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ June.quest = "Встреться с Джун в её переулке на выходных."
        play sound "audio/Sound/affection.mp3"
        "{i}Привязанность Джун увеличена.{/i}"
        $ June.affection += 5
        play music "audio/music/school.mp3"
        $ junepanick += 1
        jump day_cycle





label june_police_breakin:

    stop music fadeout 1.0
    play ambient "audio/ambient/City.mp3" volume 0.4
    scene black with fade

    "Вечер. Город кажется жутко тихим, пока ты пробираешься к месту встречи."
    play music "audio/music/june.mp3"
    scene juneclimax2 (1) with dissolve
    mc "Я здесь. Ты готова?"

    scene juneclimax2 (2) with dissolve
    j "Нет. Но у нас нет выбора."


    scene juneclimax2 (3) with dissolve
    j "Я взяла флешку на всякий случай…{w} и перцовый баллончик."

    j "Не спрашивай."

    mc "Ты реально подготовилась."
    scene juneclimax2 (2) with dissolve
    j "На кону моя жизнь, [mcname], мне нужно продумать всё.."

    mc "(Отлично, вообще никакого давления.)"
    scene juneclimax2 (3) with dissolve
    j "Так, к счастью, у меня есть смутное представление о планировке участка, этого должно хватить."

    j "Мы заходим через главную дверь. Никаких скрытных пролазок с задника, как любители."
    scene juneclimax2 (13) with dissolve
    j "Ты создаёшь отвлекающий манёвр. Хороший."
    scene juneclimax2 (10) with dissolve
    j "Что-то, что заставит дежурного офицера покинуть пост и увести тебя в другую комнату."

    mc "Есть идеи?"

    scene juneclimax2 (8) with dissolve

    j "Ты хорошо врешь, придумай что-нибудь."
    j "Займи их хотя бы минут на десять-пятнадцать."

    j "Я проскользну в подвал, где они хранят записи с камер."

    mc "Эй! Что значит «хорошо врешь»?"
    scene juneclimax2 (5) with dissolve
    j "Ты соврал мне про то, что видел мои сиськи."

    mc "Я не врал тебе! Я просто не сказал."

    j "Утаивание — это всё равно враньё."

    mc "Слушай, мы можем просто...{w}придерживаться плана?"
    scene juneclimax2 (6) with dissolve
    "Джун кивает, хотя и бросает на тебя недовольный взгляд."
    scene juneclimax2 (11) with dissolve
    j "Если всё пройдет гладко, мы должны выбраться оттуда довольно быстро."
    scene juneclimax2 (12) with dissolve
    j "Но если нет..."
    scene juneclimax2 (13) with dissolve
    j "[mcname]..."
    j "Если дерьмо полетит на вентилятор…{w} беги.{w} Не жди меня."

    mc "Джун, я—"
    scene juneclimax2 (15) with dissolve
    j "Нет смысла ждать меня."

    j "Ты ввязался в это только из-за меня, ты не должен страдать из-за моих последствий."

    mc "..."

    mc "Не-а."
    scene juneclimax2 (16) with dissolve
    j "[mcname], пожалуйста—"

    mc "Мы оба выйдем оттуда."

    mc "И как ты сказала, лучше пусть повяжут меня, чем тебя."

    mc "Но этого не произойдёт."

    mc "Мы провернём это."
    scene juneclimax2 (2) with dissolve
    "Она отводит взгляд на секунду, затем выдаёт короткий, дрожащий кивок."
    j "Я..."
    "Джун замирает, будто слова рвутся из её рта."
    scene juneclimax2 (15) with dissolve
    j "Нет, это может подождать."
    scene juneclimax2 (14) with dissolve
    j "У нас есть работа."
    scene black with fade
    "Вы вдвоём проходите последние пару кварталов в напряжённом молчании, пока в поле зрения не появляется небольшой местный полицейский участок."

    scene juneclimax2 (17) with dissolve
    mc "Вот и пришли."

    j "Давай без тягомотины. Ты ведь понял план?"

    mc "У меня простая часть, это тебе нужно удалить улики с полицейского компьютера."

    j "Смотря кого тебе придётся отвлекать, я бы не была так уверена."

    mc "Я пытаюсь сохранять оптимизм."

    mc "(Что является смене темпа для меня.)"
    stop music fadeout 1.0
    scene juneclimax2 (18) with dissolve
    play ambient "audio/ambient/Police.mp3" volume 0.35

    "В вестибюле мёртвая тишина."

    "Виден только один офицер — молодой сержант за стойкой."
    scene juneclimax2 (19) with dissolve
    j "Ну, хотя бы тут всего один типок."

    mc "Надеемся, он схавает мой пиздёж."

    j "{size=-2}Удачи…{/size}"
    scene juneclimax2 (20) with dissolve
    "Джун делает одно быстрое, скрытое сжатие твоей руки, а затем непринуждённо шагает в сторону коридора."

    play music "audio/music/changeroom.mp3"
    scene juneclimax2 (21) with dissolve
    "Прежде чем офицер успевает проследить за её направлением, ты быстро бросаешься, чтобы привлечь его внимание."

    "Ты делаешь глубокий вдох и подходишь к стойке."
    scene juneclimax2 (22) with dissolve
    mc "Извините, офицер?"

    ser "Да? В чём проблема, парень?"

    mc "Я шёл в нескольких кварталах отсюда, и кто-то попытался меня ограбить."

    mc "Он убежал, но я думаю, он всё ещё где-то рядом..."
    scene juneclimax2 (23) with dissolve
    "Сержант вздыхает, уже выглядя раздражённым от необходимости возиться с бумагами."

    ser "Ладно, заполняй заявление о происшествии."
    scene juneclimax2 (26) with dissolve
    mc "Я-Э-э..."

    mc "Вообще-то… я довольно сильно напуган."

    mc "Есть более приватное место, где мы могли бы сделать это?"

    mc "Я не особо хочу говорить об этом прямо здесь, на виду у всех."

    "Сержант оценивает тебя взглядом на мгновение, затем пожимает плечами."
    scene juneclimax2 (23) with dissolve
    ser "Ладно. Пошли за мной в допросную."

    mc "Погоди, реально?"
    scene juneclimax2 (26) with dissolve
    ser "А что не так?"

    mc "Н-Ничего, я просто думал, тут больше... ну знаешь... протоколов."
    scene juneclimax2 (24) with dissolve
    ser "..."

    ser "Парень, осмотрись."

    ser "Здесь буквально больше никого нет."
    scene juneclimax2 (23) with dissolve
    ser "Я застрял на самой скучной работе в мире, пока мои коллеги ездят на патрули."

    ser "Я каждый день слышу в ординаторской о том, как они делают облавы на наркоторговцев, накрывают притоны."

    ser "А я перебираю бумажки по парковочным штрафам и задолженностям по налогам."
    scene juneclimax2 (23) with dissolve
    ser "Так что да, послушать твою прохладную историю про ограбление станет главным событием моего дня."

    mc "..."

    mc "Вы, возможно, в депрессии, офицер."
    scene juneclimax2 (26) with dissolve
    ser "Чего ты мне яйца крутишь? Пошли быстрей."
    stop ambient fadeout 1.0
    scene black with dissolve

    "Вы проходите в небольшую комнату без окон с столом и двумя стульями."
    scene juneclimax2 (27) with dissolve
    "Офицер садится и достаёт бланк."

    ser "Так, ну…{w} рассказывай точно, что произошло."
    scene juneclimax2 (27) with dissolve
    mc "(Окей...{w}это мой шанс тянуть время так долго, как возможно.)"
    scene juneclimax2 (28) with dissolve
    ser "Ладно. Рассказывай всё по порядку. Начни с самого начала."

    mc "Ну…{w} Я шёл по Мейпл-Стрит, направлялся домой, как вдруг этот некий тип выскочил из ниоткуда—"

    ser "Опиши его."
    scene juneclimax2 (29) with dissolve
    mc "Э-э… он был среднего роста.{w} Полагаю.{w}"
    scene juneclimax2 (30) with dissolve
    ser "Цвет волос?"

    mc "Я…{w} толком не разглядел. Было темно."

    ser "Одежда?"
    scene juneclimax2 (31) with dissolve
    mc "Тёмное худи. Джинсы, вроде.{w} Ничего примечательного."

    "Ты стараешься говорить максимально размыто, затягивая каждый ответ и сохраняя дрожащий голос, будто всё ещё пребываешь в шоке."

    ser "Особые приметы? Татуировки? Шрамы? Хоть что-то?"

    mc "Не заметил… Он двигался слишком быстро."
    scene juneclimax2 (37) with dissolve
    "Офицер откидывается на спинку стула, начиная выглядеть нетерпеливым."

    ser "Что насчёт расы?"

    mc "Э-э...{w}расы?"
    scene juneclimax2 (36) with dissolve
    ser "Он был белым, чёрным, латиносом, азиатом? Дай мне хоть что-то полезное."

    "Твой мозг замыкает на секунду."

    mc "..."
    scene juneclimax2 (29) with dissolve
    ser "Ну?"

    "Ты паузишь дольше, чем следовало бы. Тишина неловко тянется в маленькой комнате."

    mc "(Чёрт…{w} что мне вообще сказать?)"

    "Ты судорожно ищешь самый безопасный и размытый ответ из возможных."
    scene juneclimax2 (38) with dissolve
    mc "Было…{w} трудно сказать, честно говоря."

    "Глаза сержанта слегка сужаются, явно раздражённые."

    ser "Трудно сказать? Парень, тебя только что ограбили, а ты даже не можешь сказать, как выглядел типок?"

    mc "На нём была балаклава!{w} Натянутая до самого низа. Только глаза были видны."

    mc "Было темно, и всё произошло слишком быстро."

    "Ты быстро добавляешь последнюю деталь, чтобы собраться, пытаясь звучать скорее напуганным, чем подозрительным."
    scene juneclimax2 (37) with dissolve
    ser "Балаклава? Почему ты не упомянул её раньше, когда говорил про волосы?"

    mc "Эй, вы задаёте мне слишком много вопросов."
    scene juneclimax2 (31) with dissolve
    ser "Я вообще-то допрос провожу..."

    mc "Я стараюсь изо всех сил, ладно, я тяжело травмирован."
    scene juneclimax2 (29) with dissolve
    ser "Травмирован."

    mc "Да."
    scene juneclimax2 (35) with dissolve
    ser "Человеком, который, как ты думаешь, был в худи и джинсах, двигался слишком быстро, чтобы заметить что-то запоминающееся—"

    ser "И при этом ты смог разглядеть, что на нём была балаклава."
    scene juneclimax2 (29) with dissolve
    mc "..."

    ser "..."

    mc "Да."
    scene juneclimax2 (40) with dissolve
    ser "Ладно…{w} продолжай. Что он тебе сказал?"

    ser "Было ли у него оружие?"

    mc "Кажется, у него был какой-то нож?"

    mc "Он блестел в темноте."

    mc "И он сказал что-то вроде..."

    mc "«Отдавай все деньги, иначе я тебя зарезаю»."
    scene juneclimax2 (28) with dissolve
    ser "Это очень...{w}прямолинейно."

    ser "Был ли у него акцент или что-то особенное в голосе?"

    mc "Э-э..."
    scene juneclimax2 (32) with dissolve
    ser "Я угадаю, что ответ — нет—"

    mc "Он был...{w}шотландцем?"
    scene juneclimax2 (31) with dissolve
    ser "Шотландцем."

    mc "Ага."
    scene juneclimax2 (29) with dissolve
    "Сержант смотрит на тебя с презрением."

    ser "Это был мужик среднего роста в обычной одежде без особых примет, в балаклаве и с шотландским акцентом."

    mc "Полагаю, да?"

    ser "..."
    scene juneclimax2 (33) with dissolve
    ser "Ну, это сильно сужает наши поиски."

    mc "Серьёзно?"
    scene juneclimax2 (37) with hpunch
    ser "Нет, идиот."
    scene juneclimax2 (36) with dissolve
    ser "Слушай, это ни к чему не ведёт, почему бы нам просто не—"
    stop music
    play sound "audio/sound/Poweroff.mp3"
    scene black with hpunch
    "Прежде чем сержант успевает сказать что-либо ещё, питание в полицейском участке гаснет."

    mc "(Чёрт! Это Джун сделала?)"

    mc "(Она не справляется? Это знак, что она в беде?)"

    "Внезапно ты получаешь сообщение на телефон."
    play sound "audio/sound/notification.mp3"
    j "{i}Сорри, мискликнула пару вещей.{/i}"

    mc "{i}Серьёзно?{/i}"

    j "{i}Эй, я не про-хакер или типа того.{/i}"

    j "{i}Но, кажется, я всё закончила, ты можешь закругляться.{/i}"
    play sound "audio/sound/poweron.mp3"
    scene juneclimax2 (41) with hpunch

    "Свет зажигается так же быстро, как и погас."

    ser "Чёртовы неисправные проводки."

    ser "Можно подумать, наш бюджет не может покрыть нормальный блок питания."
    mc "Ладно, мне, пожалуй, пора идти."
    scene juneclimax2 (28) with dissolve
    ser "Что? Ты ведь только что говорил, что травмирован?"

    mc "Мне стало лучше после того, как я рассказал, что произошло."

    mc "Спасибо! Вы отличный слушатель!"
    scene juneclimax2 (32) with dissolve
    ser "..."

    ser "Тебе повезло, что это было самым интересным событием моего дня."

    scene black with dissolve
    "Как только он встает, чтобы проводить тебя обратно в вестибюль, Джун появляется в коридоре, выглядя абсолютно непринужденно."

    scene juneclimax2 (43) with dissolve
    j "Вот ты где! Извини, я целую вечность проваландалась в туалете."
    ser "Погодите, а ты откуда взялась?"

    mc "Она подвозит меня домой."

    ser "Её нужно опросить? Или—"
    scene juneclimax2 (44) with hpunch
    j "Не-а, мы в порядке! Спасибо, офицер!"

    "Офицер кряхтит и возвращается за свой стол."

    scene black with dissolve

    "Вы оба покидаете участок настолько спокойно, насколько это возможно."

    play music "audio/music/june.mp3"
    scene juneclimax2 (45) with dissolve
    mc "Ты сделала это?"

    j "Ага…{w} Я сделала это."
    scene juneclimax2 (46) with dissolve
    j "Их безопасность — это просто жалко. Старые компы на Windows где-то 2012 года."

    j "Я просто открыла туториал на YouTube, как получить доступ к админским файлам."

    j "Я угадала пароль и удалила всё, что связано со скейт-парком."

    mc "Ты...{w}угадала пароль от полицейского компьютера?"
    scene juneclimax2 (45) with dissolve
    j "Ну, как угадала, у них на экране висела стикер-заметка «Пароль: Мылучшечемпожарные»."

    mc "..."

    mc "Стоит ли нам беспокоиться о некомпетентности полиции в этом городе?"
    scene juneclimax2 (47) with dissolve
    j "Только не в том случае, если мы сами совершаем преступления."
    scene juneclimax2 (48) with dissolve
    "Джун внезапно обхватывает голову руками."

    j "Ебать…{w} Я реально думала, что меня отправят в тот лагерь."
    scene juneclimax2 (51) with dissolve
    j "Спасибо тебе…{w} серьёзно."

    j "Я не знаю, что бы я делала без тебя сегодня."

    mc "Без проблем, я же говорил тебе, что я с тобой."
    scene juneclimax2 (50) with dissolve
    j "Я серьёзно, я не знаю людей, которые пошли бы на всё это ради кого-то ещё."

    mc "Полагаю, я не похож на большинство людей."
    scene juneclimax2 (49) with dissolve
    j "Я рада, что ты не такой."
    play sound "audio/Sound/kiss.mp3"
    scene juneclimax2 (52) with dissolve
    "Она больше ничего не говорит."

    "Она просто протягивает руку, её пальцы запутываются в ткани твоего худи, и притягивает тебя к себе."

    "Поцелуй длинный, отчаянный, со вкусом соли и облегчения."

    stop music
    scene juneclimax2 (53) with hpunch
    isa "ЛЮСИ!"

    "Голос прорезает воздух как лезвие."
    scene juneclimax2 (54) with dissolve
    "Тела вас обоих дёргаются в стороны, сердца бьются о рёбра. Температура в подворотне будто мгновенно падает."

    play music "audio/Music/Isiah.mp3" volume 1.0

    "Перед вами стоит Исайя."
    scene juneclimax2 (55) with dissolve
    "Если он и испытывает ярость в данный момент, то отлично скрывает её под внешним спокойствием."

    j "И-Исайя..."

    isa "Здравствуйте вы двое."

    isa "Довольно поздно для того, чтобы шляться возле полицейского участка, вам не кажется?"
    scene juneclimax2 (56) with dissolve
    isa "Можно подумать, вы сделали что-то, чтобы влипнуть в неприятности."
    "Лицо Джун становится мертвенно-белым. Она выглядит так, будто сейчас упадет в обморок, её ноги заметно дрожат."

    "Ты шокирован не меньше её, капли пота выступают у тебя на лице."

    mc "(Какого хера?)"

    mc "(Н-Нет...{w}Мы были осторожны...{w}Он никак не мог...)"
    scene juneclimax2 (57) with dissolve
    mc " Ч-Что...{w}Что ты здесь делаешь?"

    isa "Ну видите ли, будучи столь благочестивыми к церкви, как наша семья, ты неизбежно встречаешь единомышленников."

    isa "Вы, очевидно, не удивитесь, узнав, что последователи Христа есть в любой профессии."
    isa "Один из моих друзей на участке позвонил мне."
    scene juneclimax2 (58) with dissolve
    isa "Он сказал, что у них есть видео с камер, где моя сестра рисует граффити в скейт-парке."

    isa "Сначала я сказал ему, что он ошибся."

    isa "Что моя любимая сестра Люси никогда не сделает ничего настолько греховного."

