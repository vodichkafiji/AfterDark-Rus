default Autumngymintro = False
default Autumncityintro = False



label autumn_tv_intro:

    scene intro 0 with fade

    scene autumntvintro (1) with dissolve
    "Ты проходишь в гостиную, где отблеск телевизора отбрасывает мерцающие тени по стенам."
    scene autumntvintro (2) with dissolve
    "Отэм развалилась на диване, её глаза прикованы к экрану."
    scene autumntvintro (3) with dissolve
    a "О, привет. Хочешь посмотреть со мной «Во все тяжкие»?"


    mc "Ты смотрела это уже раз сто. Тебе самой ещё не надоело?"
    scene autumntvintro (5) with dissolve
    a "Пфф. Никогда. Это же... вершина кинематографа. К тому же, «Стук в дверь издаю я»? Это же шедевр, детка."
    scene autumntvintro (3) with dissolve

    a "Давай, садись. Ты сейчас станешь свидетелем истории телевидения."
    mc "(Её энтузиазм заразителен, хотя идея снова высиживать разборки Уолтера Уайта меня не особо вдохновляет.)"
    mc "(Она смотрела этот грёбаный сериал больше раз, чем я вообще все сериалы вместе взятые.)"
    mc "(Что ещё хуже, она всегда бубнит диалоги себе под нос.)"
    scene autumntvintro (5) with dissolve
    mc "Ладно, но только потому, что ты от этого так тащишься."

    scene autumntvintro (10) with fade

    "Ты плюхаешься на диван в момент, когда Уолт и Деклан играют в гляделки. Отэм буквально сгорает от нетерпения."

    a "О, сейчас будет!"

    "Отэм начинает бубнить реплики себе под нос, пытаясь выдать свою лучшую пародию на Брайана Крэнстона."

    a "«Метиламин вы не получите»..."


    a "«Тысяча галлонов метиламина в моих руках стоит куда больше, чем в ваших»..."

    mc "Знаешь, если ты хотела, чтобы я заценил, не стоит бросать меня в самый разгар кульминации, про которую я ничего не знаю."

    scene autumntvintro (11) with dissolve

    a "Тсс."


    "Словесный поединок продолжается, и Уолт выкладывает пакет с метом, словно роял-флеш. Глаза Отэм широко раскрыты и прикованы к экрану."

    "Она снова начинает подбирать слова вместе с героем, на этот раз чуть громче."
    scene autumntvintro (10) with dissolve

    a "«Кто ты вообще такой?»"

    a "«Скажи моё имя»."

    mc "Вот он. Твой момент истины."

    a "«Чёрт возьми, ты прав»."

    mc "(Отэм откидывается назад с удовлетворенной ухмылкой на лице, когда сцена затухает. Она смотрит на меня, явно ожидая какой-то реакции.)"
    scene autumntvintro (11) with dissolve

    a "Ну? Культово или как?"

    mc "Неплохо. У Уолта есть аура, тут не поспоришь."

    a "«Неплохо»? Фу, ну и вкусы у тебя."

    mc "(Я покачал головой, но про себя признал — это было действительно круто. Даже несмотря на то, что я понятия не имею, что там происходит.)"
    $ unlock_event(Autumn, "Say My Name", "autumn_tv_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ Autumn.quest = "Навести Отэм в скейтпарке по выходным."
        $ autumntvintro += 1
        $ Autumn.affection += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Отэм увеличена.{/i}"
        jump weekdaylivingroomnight_example




label autumn_skate_intro:

    scene skatepark with fade
    "Ты наблюдаешь за трюками на скейте и подбадриваешь скейтеров."
    play music "audio/Music/Autumn.mp3" volume 1.0 fadein 1.0

    "Едва я захожу в скейтпарк, меня встречает тихий гул колёс о бетон."
    "Отэм стоит у края рампы, её доска лежит прямо рядом с ней."

    scene autumnskateintro (1) with fade

    a "О, привет! Не думала, что ты придешь."

    mc "Просто хотел проверить, так ли ты хороша, как постоянно хвастаешься."

    scene autumnskateintro (2) with dissolve

    a "Пфф. Пожалуйста. Я сейчас поражу твой мозг."

    mc "Громкие слова. Надеюсь, ты сможешь их подтвердить."

    a "О, ещё как смогу. Но сначала — что ты вообще знаешь о скейтбординге?"

    mc "Достаточно, чтобы понимать: своротить себе шею не входит в мои планы."
    scene autumnskateintro (3) with dissolve

    a "Ха! Ожидаемо. Ты выглядишь как парень, который разложится, просто стоя на доске."

    mc "В точку."
    scene autumnskateintro (2) with dissolve

    a "Ладно, мистер «Безопасность превыше всего», давай я покажу тебе, как надо. Но смотри не моргай — а то пропустишь всю магию."

    mc "Поверь мне, я буду смотреть очень внимательно."
    scene autumnskateintro (4) with dissolve

    a "Вот и отлично. Может, чему-нибудь научишься."

    scene intro 0 with fade

    "Уверенность в её походке невозможно не заметить, когда она отталкивается и легко съезжает в рампу."

    scene autumnskateintro (5) with dissolve

    "Доска двигается словно продолжение её тела, выписывая плавные линии и выдавая чистые олли. Очевидно, что она провела бесчисленное количество часов, доводя своё мастерство до идеала."

    mc "Ладно, признаю. Навыки у тебя есть."

    a "Ещё бы, блядь. Но не стой там как зануда. Бери доску и попробуй сам."

    mc "Нет, спасибо. Я больше по части зрителей."

    a "Да ладно тебе! Что самое худшее может случиться?"

    mc "Для начала я сверну себе шею."

    a "Слабак. Ладно, но ты обязан за меня болеть."

    "Она набирает скорость, заходя на трюк — безупречный кикфлип с идеально точной посадкой."

    mc "Неплохо."

    a "Неплохо? Это было идеально. Тебе стоит конспектировать."

    mc "Я пожалуй просто посмотрю, спасибо."
    $ unlock_event(Autumn, "Mr. Safety First", "autumn_skate_intro")
    if _in_replay:
        $ renpy.end_replay()
    else:
        $ Autumn.quest = "Поговори с Отэм в гостиной вечером."
        $ autumnskateintro += 1
        $ Autumn.affection += 1
        play sound "audio/Sound/affection.mp3" volume 0.5
        "{i}Привязанность Отэм увеличена.{/i}"

        jump skateparkevening_example

label autumnskateevents:

    if autumnskateintro == 0:
        jump autumn_skate_intro
    else:
        jump skateparknoon_example

label autumntvevents:
    if autumntvintro == 0:
        jump autumn_tv_intro
    elif autumnskateintro == 1 and autumnmovie == 0:
        jump autumn_movie
    else:
        jump watch_tv_with_autumn



label autumn_movie:
    scene livingroommorning_bg with dissolve
    "Ты заходишь в гостиную, привлечённый отблесками меню телевизора, освещающими стены."
    "Отэм стоит у холодильника: в одной руке у неё огромная бадья попкорна, а в другой — пачка чипсов…"
    mc "Эй. Ты чего делаешь?"
    scene 176 with dissolve
    a "Собираюсь кино посмотреть."
    mc "Не против, если я присоединюсь?"
    scene 179 with dissolve
    a "Ты? Добровольно присоединишься ко мне для просмотра фильма? Я что, попала в параллельную вселенную?"
    mc "Да нет, просто ностальгия нахлынула. Помнишь, как мы сидели тут и часами смотрели тупые фильмы?"
    scene 182 with dissolve
    a "О да. Ты притворялся профессиональным критиком, а я ржала так, что дышать не могла."
    mc "Я и сейчас стою на своём: «Зомби-школа 3» была недооценённым шедевром."
    scene 185 with dissolve
    a "Ага. Недооценённым буквально всеми, кто его смотрел."
    scene 176 with dissolve
    a "Можешь садиться, если хочешь, но чипсы не трогай. Я их пересчитала."
    mc "Ты пересчитала чипсы?"
    a "Оценила на глаз. Очень щедро."
    scene black with dissolve
    "Она поворачивается и шаркает по коридору в сторону гостиной, оставляя за собой шлейф запаха масла и соли."
    mc "(Ну... это всё равно лучше, чем считать обороты вентилятора на потолке.)"
    "Ты идёшь за ней."
    "Она похлопывает по дивану рядом с собой. Ты падаешь рядом, подушки тяжело проседают под тобой."
    scene 195 with dissolve
    mc "Так, ну и какие у нас варианты на вечер?"
    a "Стриминговая рулетка. У нас есть Netflix, Disney Plus, Prime Video..."
    mc "Окей, звучит—"
    scene 199 with dissolve
    a "А ещё Streamo, Flunki, Pibmow, Neepee и Skunt."
    scene 201 with dissolve
    mc "…чего?"
    a "В смысле «чего»?"
    "Ты хлопаешь глазами, смотря на неё. Она смотрит в ответ с абсолютно каменным лицом."
    mc "Отэм. Их не существует."
    scene 206 with dissolve
    a "Нет, они существуют."
    "Заметка редактора: Да, они все реальны."
    mc "Что они, блядь, вообще крутят на этом вашем «Skunt»?"
    a "Без понятия, ни разу не включала."
    scene 211 with dissolve
    mc "Тогда нахрена мы за него платим!?"
    a "Моя мама фильмоголик, забыл? Мы просто пользуемся её аккаунтами."
    mc "Не думаю, что слово «фильмоголик» существует."
    a "Теперь существует. Я его придумала. Не за что."
    scene 216 with dissolve
    "Она ухмыляется, листая бесконечную карусель названий."
    a "Ладно, критик. Выбирай сегодняшнее кинематографическое бедствие."
    mc "Давай просто остановимся на Netflix."
    scene 220 with dissolve
    a "Клянусь, превью каждого фильма выглядит так, будто его делал тот же чувак, который придумывает названия для энергетиков."
    mc "«Бесконечная скорость», «Протокол поцелуя», «Месть 2: Всё ещё мстим»."
    a "Вот-вот! Куда делись нормальные названия?"
    mc "Мы просто постарели. Наш пик был тогда, когда «Ловушка для родителей» казалась высоким искусством."
    scene 260 with dissolve
    mc "Так, никаких ужастиков. Я не собираюсь ещё неделю наблюдать, как ты проверяешь коридор каждый раз, когда мигает свет."
    a "Эй! Мы были детьми, когда смотрели это, и я просто проявляла бдительность!"
    scene 228 with dissolve
    mc "Ты визжала, когда тостер выплёвывал хлеб."
    a "Всё, что я слышу — это то, что у меня инстинкт выживания развит лучше, чем у тебя."
    "Вы оба смеётесь. Это ощущается совсем как в детстве — просто сидеть, подкалывать друг друга и пинать хуи."
    scene 232 with dissolve
    a "Ладно, как насчёт ромкома? Может, «Реальная любовь»? Или тот, где Райан Гослинг много орет?"
    mc "Ты имеешь в виду вообще каждый фильм с Райаном Гослингом?"
    a "Именно. Поэтому это отличный выбор."
    mc "Мимо. Ромкомы потеряли всё своё очарование без твоих фальшивых комментариев."
    a "Ты про то время, когда мы сидели тут и стебали их, пока мама не выгоняла нас на улицу?"
    mc "Ага. Простые были времена. Меньше проблем."
    a "И меньше чеки за чипсы."
    "Она слабо улыбается, в её голосе слышна лёгкая ностальгия. Листание останавливается."
    scene 241 with dissolve
    mc "Ладно, к чёрту. Пойдём по крупному. {i}*Титаник.*{/i}"
    a "Серьёзно? Три часа мокрой трагедии?"
    mc "Мы сможем поугорать над романтикой и при этом чувствовать себя умниками."
    a "Ладно. Но если заиграет Селин Дион, я ухожу."
    mc "Святотатство. Эта песня священна."

    scene autummovie (1) with dissolve
    "Она нажимает на «play». Начальные титры сопровождаются струнной музыкой, подводные обломки скользят в холодном синем свете."
    scene 248 with dissolve
    a "Знаешь, я каждый раз забываю, как круто выглядит первый акт. Все эти старые декорации."
    "Фильм входит в свой ритм. Вы оба вполглаза смотрите и параллельно шутите."
    scene 256 with dissolve
    "Спустя пару сцен она наклоняет голову."
    a "Ладно, но молодой Леонардо Ди Каприо? Он был {i}*красавчиком.*{/i}"
    mc "Ты всё ещё технически в его вкусе."
    scene 260 with dissolve
    a "А?"
    mc "Он не встречается ни с кем старше двадцати пяти."
    a "Это... фу! Откуда ты вообще это знаешь?"
    mc "Интернет проклял меня бесполезными знаниями."
    scene 265 with dissolve
    "Она кидает в тебя попкорном, едва скрывая смех."
    scene autummovie (2) with dissolve
    "Полчаса спустя фильм переходит к своей кульминации. Джек рисует Розу при свечах."
    a "Он рисует так, будто от этого зависит его жизнь."
    mc "Ну, честно говоря, если бы перед тобой легла горячая голая девка и попросила нарисовать её, думаю, большинство парней старались бы изо всех сил."
    scene 228 with dissolve
    a "Оу, неужели~"
    a "То есть ты хочешь сказать... если бы нужная девушка оказалась перед тобой, ты бы превратился в Леонардо да Винчи?"
    mc "Ну, я едва могу нарисовать человечка из палочек, но ради искусства? Я бы пошёл на эту жертву."
    a "Пфф, ну человечек из палочек с сиськами — это уже хоть что-то."
    scene autummovie (3) with dissolve
    "Настроение меняется, когда начинается секс-сцена, и музыка нарастает."
    scene 275 with dissolve
    mc "О нет. Началось."
    a "Приготовься к удару."
    "Вы оба начинаете наигранно корчиться от отвращения."
    mc "{i}Бле-е-е, кака сущая!{/i}"
    scene 280 with dissolve
    a "{i}Какой срам! Спрячьте детей!{/i}"
    "Она ржёт слишком громко, явно получая от этого удовольствие."
    mc "Ты притворяешься, что тебе мерзко."
    scene 284 with dissolve
    a "Не-а!"
    mc "Ты улыбаешься!"
    a "Это моё лицо ужаса."
    play music "audio/Music/Nights.mp3" 
    scene black with fade
    "Вы оба валитесь от смеха, пульт заваливается между подушками."
    "Сцена заканчивается, и вы сидите в комфортной тишине, лишь мягкие отблески экрана наполняют комнату."
    scene 291 with dissolve
    "Солнце за окном угасает, пока фильм продолжается."
    a "Каждый раз, когда я это смотрю, я думаю: «Может, в этот раз они обойдут айсберг?»"
    mc "Тогда это было бы очень скучное кино."
    scene 295 with dissolve
    a "Чувак, ты просто ни хрена не шаришь в хорошей романтике."
    mc "В смысле? Посмотри на меня, разве это и так не очевидно?"
    scene autummovie (4) with dissolve
    "Идёт последний акт — Джек дрожит в воде, Роза плачет под замёрзшим небом."
    scene 299 with dissolve
    mc "Чувак, ты что, плачешь?"
    a "Что! Н-нет, просто аллергия! Я вообще в порядке."
    "Её голос слегка ломается, но она ухмыляется, чтобы скрыть это."
    scene autummovie (5) with dissolve
    "Когда наконец идут титры, комната погружается в тишину, нарушаемую только фоновой музыкой."
    mc "Мораль истории: никогда не верь богачам и айсбергам."
    scene 306 with dissolve
    "Ты встаёшь и потягиваешься. Свет от титров мигает на её лице — она выглядит уставшей, но умиротворённой."
    mc "Ладно, я пошёл спать, пока мы не ввязались в трёхчасовой спор про двери и плавучесть."
    a "Иди. Я, пожалуй, ещё немного постою тут."

    mc "Уверена?"
    a "Ага... Может, потом ещё прошвырнусь по улице."
    mc "Ночью?"
    a "Эх... {w}У нас во дворе обычно тихо, вряд ли кто-то попытается меня пырнуть."

    mc "Ладно, будь осторожна."

    a "Обязательно! Спокойной ночи!"

    mc "Спокойной ночи, Отэм."
    scene black with fade

    "Спустя некоторое время, находясь в своей комнате, ты слышишь, как хлопает входная дверь."

    mc "(Это, должно быть, Отэм...{w}Она что, часто гуляет по ночам?)"

    mc "(Чёрт! Надеюсь, она никогда не видела, как я сбегаю через окно!)"
    scene autummovie (6) with dissolve
    "Проходят часы, ты сидишь в своей комнате и играешь в видеоигры."
    "Как и большинством ночей, ты потерял счет времени."
    scene autummovie (7) with dissolve
    "Придя в себя, ты слышишь низкий гудящий звук, доносящийся из гостиной."

    mc "Хммм, кажется, Отэм снова забыла выключить телевизор."
    scene autummovie (8) with dissolve
    mc "Клянусь, если бы она увидела счёт за электричество, она бы больше никогда не забывала."
    scene black with fade
    "В коридоре темно, единственный свет слабо пробивается из гостиной, переливаясь синими и фиолетовыми оттенками."


    scene autummovie (9) with dissolve
    "Низкое бубнение телевизора всё ещё слышно — секс-сцена из «Титаника» тихо гоняется по кругу."
    "Ты замечаешь дрожащий силуэт на диване."

    mc "(Отэм всё ещё не спит? Какого хрена она...)"

    "И тут ты слышишь её."

    "Сначала тихо, просто дрожащий выдох сквозь приоткрытые губы."
    scene autumntv1 with dissolve
    a "ммх…"

    "Одеяло шевелится."

    "Сначала медленные, размеренные круговые движения, едва слышные — ткань тихо шуршит сама о себя."


    scene autumntv2 with dissolve
    "Затем быстрее."

    a "ннх… хаа…"

    "Её дыхание становится частым, рваным. Каждый вдох застревает в горле, словно она пытается молчать, но у неё не выходит."

    "Диван один раз скрипит, когда её бедра подаются вверх, следуя за собственной рукой."

    "Теперь ты слышишь этот влажный, тихий, ни с чем не сравнимый звук, вырывающийся из-под одеяла при каждом движении."
    scene autumntv3 with dissolve

    "Пальцы на её ногах поджимаются, ступни напряжены, пятка въедается в диван."

    a "ах— блядь…"

    "Это едва слышный шёпот, сорванный и жаждущий."

    "Её ритм сбивается. Замедляется. А затем резко становится неистовым."

    scene autumntv4 with flash

