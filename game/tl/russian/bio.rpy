transform fullhd_to_4k:
    size (3840, 2160)
    parallel:
        xalign 0.5
        yalign 0.5
        xoffset 0
        yoffset 0
        linear 10.0 xoffset -3840
        repeat
transform fullhd_to_4k_2:
    size (3840, 2160)
    parallel:
        xalign 0.5
        yalign 0.5
        xoffset 3840
        yoffset 0
        linear 10.0 xoffset 0
        repeat
default bio_current_page = 0
default sidebio_current_page = 0
screen bio:
    tag menu

    add "images/bio/" + bio_names[bio_current_page] + "_background.jpg" at fullhd_to_4k
    add "images/bio/" + bio_names[bio_current_page] + "_background.jpg" at fullhd_to_4k_2
    textbutton "назад" action Return()

    add "images/bio/" + bio_names[bio_current_page] + ".png" xpos - 1000

    label bio_names[bio_current_page]:
        text_size 250
        text_color "#ffffff"
        text_font "Fonts/NotoSansDisplay-ExtraBold.ttf"
        xalign 0.8

    vbox:
        xalign 0.55
        yalign 0.6
        spacing 100
        xanchor 0.3

        for key, value in bio_data[bio_names[bio_current_page]].items():
            label "[key]: [value]":
                text_size 130
                text_color "#fff"
                xmaximum 2300
                yminimum 100
                substitute True
                text_font "Fonts/NotoSansDisplay-ExtraBold.ttf"

    $ change_back = len(bio_names) - 1 if bio_current_page == 0 else bio_current_page - 1
    textbutton "<":
        xalign 0.01
        yalign 0.5
        text_size 400
        action SetVariable("bio_current_page", change_back)

    $ change_next = 0 if bio_current_page == len(bio_names) - 1 else bio_current_page + 1
    textbutton ">":
        xalign 1.0
        yalign 0.5
        text_size 400
        action SetVariable("bio_current_page", change_next)

